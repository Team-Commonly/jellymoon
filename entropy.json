{
  "$comment": "Entropy budgets enforced by `make entropy` (scripts/check-entropy.mjs). Exceptions may only shrink: a new one must cite a docs/adr/ note in its reason. LOC budgets cover hand-written code only; generated files and fixtures are excluded.",
  "maxFileLines": 400,
  "maxFunctionLines": 60,
  "generated": [
    "gen/",
    "daemon/internal/protocol/gen.go",
    "schema/fixtures/",
    "bun.lock",
    "go.sum"
  ],
  "markerScanSkip": [
    "scripts/check-entropy.mjs"
  ],
  "locBudget": {
    "core": {
      "paths": [
        "schema/",
        "scripts/"
      ],
      "max": 4580
    },
    "worker": {
      "paths": [
        "worker/"
      ],
      "max": 2560
    },
    "server": {
      "paths": [
        "server/"
      ],
      "max": 4480
    },
    "podcore": {
      "paths": [
        "podcore/"
      ],
      "max": 3110
    },
    "daemon": {
      "paths": [
        "daemon/"
      ],
      "max": 7960
    },
    "web": {
      "paths": [
        "web/"
      ],
      "max": 2550
    },
    "e2e": {
      "paths": [
        "e2e/"
      ],
      "max": 9760
    }
  },
  "goImports": {
    "daemon/internal/protocol": {
      "allow": [
        "std"
      ]
    }
  },
  "exceptions": {
    "files": {},
    "functions": {}
  }
}
