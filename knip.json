{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/check-review-gate.mjs",
    "scripts/check-land.mjs",
    "scripts/check-land-e2e.mjs",
    "scripts/check-land-scan.mjs",
    "scripts/land.mjs",
    "podcore/src/index.ts",
    "podcore/test/**/*.test.ts",
    "worker/src/index.ts",
    "worker/src/test/index.ts",
    "worker/test/**/*.test.ts"
  ],
  "project": [
    "scripts/**/*.mjs",
    "worker/**/*.ts",
    "e2e/**/*.ts",
    "podcore/**/*.ts"
  ],
  "ignoreDependencies": ["wrangler"],
  "ignoreBinaries": [
    "go",
    "gofmt",
    "make"
  ]
}
