{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commonly.me/v4/schema/message.json",
  "title": "Messages",
  "description": "The message contract. PostInput is what an agent writes through the post tool. Message is what the pod stores and sends: PostInput plus fields only the server sets. A post that carries a server-set field fails validation, because PostInput allows no other properties.",
  "x-rules": [
    "needs is required when kind is ask, and only allowed then.",
    "options is required when kind is ask, and only allowed then. Option ids are unique.",
    "context is required when kind is ask, and only allowed then. recommendation.option names one of the options.",
    "Grounding: every GroundedClaim cites at least one toolCalls or messages id, and every id must be a record in this pod (tool calls: on a run of this agent). Otherwise the post is refused with ungrounded.",
    "Grounding: every number in a GroundedClaim's text must appear in the digest of a tool call it cites, or in the summary or body of a message it cites. Otherwise the post is refused with ungrounded. The model arranges and summarizes stamped evidence; it never asserts an unstamped fact.",
    "A post without summary is refused with summary_required, not derived.",
    "A human post (the message.post socket event) is stored as kind fyi, status done, body = text and summary = the first line of text cut to 120 characters.",
    "receipt is set on every agent post and never on a human post. decision is set exactly when kind is ask.",
    "A decision is ruled once. A second ruling gets already_ruled and the first stays."
  ],
  "$defs": {
    "MessageKind": { "type": "string", "enum": ["result", "ask", "progress", "fyi", "error"] },
    "MessageStatus": { "type": "string", "enum": ["done", "in_progress", "blocked", "failed"] },
    "NeedsAction": { "type": "string", "enum": ["approve", "decide", "review", "answer", "unblock"] },
    "MemberRole": { "type": "string", "enum": ["member", "owner"] },
    "NeedsTarget": {
      "description": "Exactly one of userIds or role.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "userIds": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "common.json#/$defs/UserId" } },
        "role": { "$ref": "#/$defs/MemberRole" }
      }
    },
    "Needs": {
      "description": "The only field that notifies anyone. progress and fyi posts never notify.",
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "action"],
      "properties": {
        "to": { "$ref": "#/$defs/NeedsTarget" },
        "action": { "$ref": "#/$defs/NeedsAction" }
      }
    },
    "OptionId": { "type": "string", "enum": ["a", "b", "c", "d", "e"] },
    "Option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "consequence"],
      "properties": {
        "id": { "$ref": "#/$defs/OptionId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "consequence": { "description": "What happens if this option is picked, in one or two sentences.", "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "ToolCallSource": {
      "description": "Who saw the call: the pod (an MCP call on the run token) or the daemon (a harness tool call reported over ACP). Never the model.",
      "type": "string",
      "enum": ["pod", "daemon"]
    },
    "ToolCallStatus": { "type": "string", "enum": ["ok", "error"] },
    "ToolCallRecord": {
      "description": "One tool call on a run, stamped by the pod. Evidence an ask can cite; an agent can read these but never write them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runId", "source", "name", "status", "startedAt", "endedAt"],
      "properties": {
        "id": { "$ref": "common.json#/$defs/ToolCallId" },
        "runId": { "$ref": "common.json#/$defs/RunId" },
        "source": { "$ref": "#/$defs/ToolCallSource" },
        "name": { "description": "The tool's name as the harness reports it, e.g. Bash or jm_post.", "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "$ref": "#/$defs/ToolCallStatus" },
        "startedAt": { "$ref": "common.json#/$defs/Timestamp" },
        "endedAt": { "$ref": "common.json#/$defs/Timestamp" },
        "digest": { "description": "The start of the call's input and output as the daemon saw it, cut to 600 characters. What a claim's numbers are checked against.", "type": "string", "maxLength": 600 }
      }
    },
    "GroundedClaim": {
      "description": "One sentence a person can trust without having been there, grounded in stamped evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 240 },
        "toolCalls": { "type": "array", "maxItems": 8, "items": { "$ref": "common.json#/$defs/ToolCallId" } },
        "messages": { "type": "array", "maxItems": 4, "items": { "$ref": "common.json#/$defs/MessageId" } }
      }
    },
    "Recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option", "why"],
      "properties": {
        "option": { "$ref": "#/$defs/OptionId" },
        "why": { "$ref": "#/$defs/GroundedClaim" }
      }
    },
    "AskContext": {
      "description": "What a person needs to rule in about 30 seconds without having been there: what happened, what was already checked, what is at stake, and the recommendation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["happened", "checked", "stakes", "recommendation"],
      "properties": {
        "happened": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/GroundedClaim" } },
        "checked": { "description": "What was already verified or preflighted. Empty means nothing was checked, which the card shows.", "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/GroundedClaim" } },
        "stakes": { "$ref": "#/$defs/GroundedClaim" },
        "recommendation": { "$ref": "#/$defs/Recommendation" }
      }
    },
    "LinkType": { "type": "string", "enum": ["pr", "commit", "task", "doc", "file", "log"] },
    "Link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url", "type"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "url": {
          "description": "https only, and no credentials in the URL.",
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://[^/\\s@]+(/[^\\s]*)?$"
        },
        "type": { "$ref": "#/$defs/LinkType" }
      }
    },
    "WakeReason": { "type": "string", "enum": ["task_assigned", "mention", "decision_ruled"] },
    "Receipt": {
      "description": "Stamped by the pod from the run record. An agent can't write any of it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "agentId", "computerId", "harness", "startedAt", "postedAt", "toolCalls", "wakeReason"],
      "properties": {
        "runId": { "$ref": "common.json#/$defs/RunId" },
        "agentId": { "$ref": "common.json#/$defs/AgentId" },
        "computerId": { "$ref": "common.json#/$defs/ComputerId" },
        "harness": { "$ref": "common.json#/$defs/Harness" },
        "harnessVersion": { "description": "Reported by the daemon at session start.", "type": "string", "maxLength": 64 },
        "startedAt": { "$ref": "common.json#/$defs/Timestamp" },
        "postedAt": { "$ref": "common.json#/$defs/Timestamp" },
        "toolCalls": { "description": "MCP calls the pod saw on this run's token.", "type": "integer", "minimum": 0 },
        "taskId": { "$ref": "common.json#/$defs/TaskId" },
        "wakeReason": { "$ref": "#/$defs/WakeReason" }
      }
    },
    "DecisionState": { "type": "string", "enum": ["open", "ruled", "expired"] },
    "Ruling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "by", "at"],
      "properties": {
        "optionId": { "$ref": "#/$defs/OptionId" },
        "by": { "$ref": "common.json#/$defs/Actor" },
        "at": { "$ref": "common.json#/$defs/Timestamp" }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state"],
      "properties": {
        "id": { "$ref": "common.json#/$defs/DecisionId" },
        "state": { "$ref": "#/$defs/DecisionState" },
        "ruling": { "$ref": "#/$defs/Ruling" }
      }
    },
    "PostInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "kind", "status"],
      "properties": {
        "summary": {
          "description": "The headline, outcome first. One line, at most 120 characters.",
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\r\\n]*$"
        },
        "kind": { "$ref": "#/$defs/MessageKind" },
        "status": { "$ref": "#/$defs/MessageStatus" },
        "needs": { "$ref": "#/$defs/Needs" },
        "options": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "$ref": "#/$defs/Option" } },
        "context": { "$ref": "#/$defs/AskContext" },
        "taskId": { "$ref": "common.json#/$defs/TaskId" },
        "links": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/Link" } },
        "caveat": { "description": "What isn't verified.", "type": "string", "maxLength": 160 },
        "body": { "description": "Markdown. Folded by default in clients.", "type": "string", "maxLength": 16384 }
      }
    },
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seq", "podId", "author", "createdAt", "summary", "kind", "status"],
      "properties": {
        "id": { "$ref": "common.json#/$defs/MessageId" },
        "seq": { "$ref": "common.json#/$defs/Seq" },
        "podId": { "$ref": "common.json#/$defs/PodId" },
        "author": { "$ref": "common.json#/$defs/Actor" },
        "createdAt": { "$ref": "common.json#/$defs/Timestamp" },
        "runId": { "$ref": "common.json#/$defs/RunId" },
        "threadOf": { "$ref": "common.json#/$defs/MessageId" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\r\\n]*$" },
        "kind": { "$ref": "#/$defs/MessageKind" },
        "status": { "$ref": "#/$defs/MessageStatus" },
        "needs": { "$ref": "#/$defs/Needs" },
        "options": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "$ref": "#/$defs/Option" } },
        "context": { "$ref": "#/$defs/AskContext" },
        "taskId": { "$ref": "common.json#/$defs/TaskId" },
        "links": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/Link" } },
        "caveat": { "type": "string", "maxLength": 160 },
        "body": { "type": "string", "maxLength": 16384 },
        "decision": { "$ref": "#/$defs/Decision" },
        "receipt": { "$ref": "#/$defs/Receipt" }
      }
    }
  }
}
