{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jellymoon.dev/schema/v1/task.json",
  "title": "Tasks",
  "$defs": {
    "TaskStatus": { "description": "The state of a task on the board.", "type": "string", "enum": ["open", "in_progress", "blocked", "done", "failed"] },
    "TaskKind": {
      "description": "What kind of work a task is, set by its creator, so policy never guesses from the title. security is never folded into fix: it always gets its own review.",
      "type": "string",
      "enum": ["feature", "fix", "security", "design", "research", "chore"]
    },
    "Claim": {
      "description": "One active claim per task. The lease is renewed by any MCP call on the claiming run.",
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "runId", "leaseUntil"],
      "properties": { "by": { "$ref": "common.json#/$defs/Actor" }, "runId": { "$ref": "common.json#/$defs/RunId" }, "leaseUntil": { "$ref": "common.json#/$defs/Timestamp" } }
    },
    "Task": {
      "description": "A unit of work on the pod's board, with a kind and a status, and optionally an assignee and a claim.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "podId", "title", "kind", "status", "createdBy", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "common.json#/$defs/TaskId" },
        "podId": { "$ref": "common.json#/$defs/PodId" },
        "title": { "description": "What the task is called.", "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "$ref": "#/$defs/TaskKind" },
        "body": { "description": "Details of the work, beyond the title.", "type": "string", "maxLength": 16384 },
        "status": { "$ref": "#/$defs/TaskStatus" },
        "assignee": { "$ref": "common.json#/$defs/ActorId" },
        "createdBy": { "$ref": "common.json#/$defs/Actor" },
        "claim": { "$ref": "#/$defs/Claim" },
        "createdAt": { "$ref": "common.json#/$defs/Timestamp" },
        "updatedAt": { "$ref": "common.json#/$defs/Timestamp" }
      }
    }
  }
}
