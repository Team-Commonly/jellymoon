{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/check-review-gate.mjs",
    "scripts/check-scan-history.mjs",
    "scripts/check-scan-checkout.mjs",
    "scripts/check-land.mjs",
    "scripts/check-land-e2e.mjs",
    "scripts/check-land-scan.mjs",
    "scripts/land.mjs",
    "podcore/src/index.ts",
    "podcore/test/**/*.test.ts",
    "worker/src/index.ts",
    "worker/src/test/index.ts",
    "worker/test/**/*.test.ts",
    "server/src/main.ts",
    "server/src/pglite-template.ts",
    "server/test/**/*.test.ts",
    "web/src/main.tsx",
    "web/vite.config.ts",
    "web/src/**/*.test.{ts,tsx}",
    "web-e2e/playwright.config.ts",
    "web-e2e/global-setup.ts",
    "web-e2e/*.spec.ts"
  ],
  "project": [
    "web/**/*.{ts,tsx}",
    "web-e2e/**/*.ts",
    "scripts/**/*.mjs",
    "worker/**/*.ts",
    "server/**/*.ts",
    "e2e/**/*.ts",
    "podcore/**/*.ts"
  ],
  "ignoreDependencies": ["wrangler", "ws"],
  "ignoreBinaries": [
    "go",
    "gofmt",
    "make"
  ]
}
