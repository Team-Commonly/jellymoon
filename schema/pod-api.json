{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jellymoon.dev/schema/v1/pod-api.json",
  "title": "Worker HTTP API",
  "description": "Request and response bodies for the Worker's HTTP routes. Every error response body is common.json ErrorBody. The Worker validates, authenticates, then calls the pod Durable Object; all authorization lives in the pod, never the client.",
  "x-routes": [
    { "method": "POST", "path": "/v1/auth/device", "auth": "none", "response": "DeviceStartResponse" },
    { "method": "POST", "path": "/v1/auth/device/token", "auth": "none", "request": "DeviceTokenRequest", "response": "DeviceTokenResponse" },
    { "method": "POST", "path": "/v1/pods", "auth": "user", "request": "CreatePodRequest", "response": "Pod" },
    { "method": "POST", "path": "/v1/pods/:pod/invites", "auth": "user", "request": "CreateInviteRequest", "response": "Invite" },
    { "method": "POST", "path": "/v1/invites/:code/accept", "auth": "user", "response": "AcceptInviteResponse" },
    { "method": "POST", "path": "/v1/computers", "auth": "user", "request": "RegisterComputerRequest", "response": "RegisterComputerResponse" },
    { "method": "POST", "path": "/v1/pods/:pod/agents", "auth": "computer", "request": "RegisterAgentRequest", "response": "RegisterAgentResponse" },
    { "method": "GET", "path": "/v1/pods/:pod/ws", "auth": "user|computer", "upgrade": "websocket" },
    { "method": "POST", "path": "/v1/runs", "auth": "computer", "request": "ClaimRunRequest", "response": "ClaimRunResponse" },
    { "method": "POST", "path": "/v1/runs/:run/end", "auth": "computer", "request": "EndRunRequest" },
    { "method": "POST", "path": "/mcp", "auth": "run|user", "protocol": "mcp-streamable-http, stateless; the MCP adapter over operations.json" }
  ],
  "x-rules": [
    "/__test/* routes exist only when ENV is local or preview, and are absent from the production bundle.",
    "A device code polled before approval gets authorization_pending; after approval exactly one exchange succeeds and the next gets invalid_grant; an expired code gets expired_token.",
    "A used or expired invite gets gone (HTTP 410). Only a member can create an invite.",
    "cancelled is final. A later POST /v1/runs/:run/end for a run a person stopped is accepted and does not change the outcome."
  ],
  "$defs": {
    "DeviceStartResponse": {
      "description": "The answer to starting a device sign-in: the code the client exchanges for a token and the code the person types.",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceCode", "userCode", "verificationUri", "interval", "expiresIn"],
      "properties": {
        "deviceCode": { "description": "The code the client exchanges for a token.", "type": "string", "minLength": 32, "maxLength": 128 },
        "userCode": { "description": "What the person types on the sign-in page, e.g. WDJB-MJHT.", "type": "string", "pattern": "^[BCDFGHJKLMNPQRSTVWXZ]{4}-[BCDFGHJKLMNPQRSTVWXZ]{4}$" },
        "verificationUri": { "description": "The page where the person enters the user code. https only.", "type": "string", "pattern": "^https://" },
        "interval": { "description": "Seconds between polls.", "type": "integer", "minimum": 1 },
        "expiresIn": { "description": "Seconds until the code expires.", "type": "integer", "minimum": 1 }
      }
    },
    "DeviceTokenRequest": {
      "description": "Exchanges a device code for a user token once the person has approved it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceCode"],
      "properties": {
        "deviceCode": { "description": "The deviceCode from the sign-in start.", "type": "string", "minLength": 32, "maxLength": 128 }
      }
    },
    "DeviceTokenResponse": {
      "description": "A user token and the user it belongs to.",
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "user", "expiresAt"],
      "properties": { "token": { "$ref": "tokens.json#/$defs/UserToken" }, "user": { "$ref": "common.json#/$defs/Actor" }, "expiresAt": { "$ref": "common.json#/$defs/Timestamp" } }
    },
    "CreatePodRequest": {
      "description": "Creates a pod.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "description": "The pod's name.", "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "Pod": {
      "description": "A pod: its id, name and creation time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "createdAt"],
      "properties": {
        "id": { "$ref": "common.json#/$defs/PodId" },
        "name": { "description": "The pod's name.", "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAt": { "$ref": "common.json#/$defs/Timestamp" }
      }
    },
    "CreateInviteRequest": {
      "description": "Options for a new invite. Both fields have defaults.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxUses": { "description": "Defaults to 1.", "type": "integer", "minimum": 1, "maximum": 100 },
        "ttlSeconds": { "description": "Defaults to 7 days.", "type": "integer", "minimum": 60, "maximum": 2592000 }
      }
    },
    "Invite": {
      "description": "An invite to a pod: its code and link, when it expires and how many uses are left.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "url", "expiresAt", "usesLeft"],
      "properties": {
        "code": { "description": "The code a person gives to accept the invite.", "type": "string", "pattern": "^inv_[0-9A-Za-z]{22}$" },
        "url": { "description": "The link to share. https only.", "type": "string", "pattern": "^https://" },
        "expiresAt": { "$ref": "common.json#/$defs/Timestamp" },
        "usesLeft": { "description": "How many more times the invite can be accepted.", "type": "integer", "minimum": 0 }
      }
    },
    "AcceptInviteResponse": {
      "description": "The pod the person joined.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pod"],
      "properties": { "pod": { "$ref": "#/$defs/Pod" } }
    },
    "OS": { "description": "A computer's operating system.", "type": "string", "enum": ["darwin", "linux"] },
    "Arch": { "description": "A computer's CPU architecture.", "type": "string", "enum": ["arm64", "amd64"] },
    "RegisterComputerRequest": {
      "description": "A daemon registers its computer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "os", "arch"],
      "properties": {
        "name": { "description": "A name for the computer.", "type": "string", "minLength": 1, "maxLength": 80 },
        "os": { "$ref": "#/$defs/OS" },
        "arch": { "$ref": "#/$defs/Arch" }
      }
    },
    "RegisterComputerResponse": {
      "description": "The new computer's id and its computer token.",
      "type": "object",
      "additionalProperties": false,
      "required": ["computerId", "token"],
      "properties": { "computerId": { "$ref": "common.json#/$defs/ComputerId" }, "token": { "$ref": "tokens.json#/$defs/ComputerToken" } }
    },
    "RegisterAgentRequest": {
      "description": "A computer registers an agent in a pod.",
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "displayName"],
      "properties": {
        "harness": { "$ref": "common.json#/$defs/Harness" },
        "displayName": { "description": "The name shown to people.", "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "RegisterAgentResponse": {
      "description": "The new agent's id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId"],
      "properties": { "agentId": { "$ref": "common.json#/$defs/AgentId" } }
    },
    "ClaimRunRequest": {
      "description": "The daemon claims a run for a wake.",
      "type": "object",
      "additionalProperties": false,
      "required": ["wakeId"],
      "properties": { "wakeId": { "$ref": "common.json#/$defs/WakeId" } }
    },
    "ClaimRunResponse": {
      "description": "The brief is built by the server and sent as the agent's first prompt. The run token goes to the agent; the computer token never does.",
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "runToken", "brief", "mcpUrl", "expiresAt"],
      "properties": {
        "runId": { "$ref": "common.json#/$defs/RunId" },
        "runToken": { "$ref": "tokens.json#/$defs/RunToken" },
        "brief": { "description": "The agent's first prompt, built by the server.", "type": "string", "minLength": 1, "maxLength": 32768 },
        "mcpUrl": { "description": "Where the agent reaches the pod's MCP server for this run. The run token is sent here, so https only, except http://localhost and http://127.0.0.1 for local development.", "type": "string", "pattern": "^(https://|http://(localhost|127\\.0\\.0\\.1)([:/]|$))" },
        "expiresAt": { "$ref": "common.json#/$defs/Timestamp" }
      }
    },
    "RunOutcome": { "description": "How a run ended: completed, failed or cancelled.", "type": "string", "enum": ["completed", "failed", "cancelled"] },
    "EndRunRequest": {
      "description": "The daemon reports that a run ended.",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": { "$ref": "#/$defs/RunOutcome" },
        "harnessVersion": { "description": "The harness version, as the daemon reports it.", "type": "string", "maxLength": 64 }
      }
    }
  }
}
